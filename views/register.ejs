<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create User</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="page page--plain">
    <main class="auth-wrap">
      <h1>Create User</h1>
      <form class="auth-row" method="post" action="/create_user">
        <input type="text" name="username" placeholder="Username" required />
        <button type="submit" class="btn-native">Register</button>
      </form>
      <a class="link link--plain" href="/login">Shop Home</a>
    </main>
  </body>
</html>
